@page
@model MedBI.ClientSide.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="card-title text-center mb-4">Register</h2>

                    @if (TempData["RegisterSuccess"] != null)
                    {
                        <div class="alert alert-success mt-3" role="alert">
                            @TempData["RegisterSuccess"]
                        </div>
                    }

                    <form method="post" novalidate>
                        <div class="mb-3">
                            <label asp-for="Register.Username" class="form-label">Username</label>
                            <input asp-for="Register.Username" class="form-control" placeholder="Choose a username" />
                            <span asp-validation-for="Register.Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Register.Email" class="form-label">Email</label>
                            <input asp-for="Register.Email" class="form-control" type="email" placeholder="you@example.com" />
                            <span asp-validation-for="Register.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Register.Password" class="form-label">Password</label>
                            <input asp-for="Register.Password" class="form-control" type="password" placeholder="••••••••" />
                            <span asp-validation-for="Register.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Register.Role" class="form-label">Role</label>
                            <select asp-for="Register.Role" class="form-select">
                                <option value="">-- Select Role --</option>
                                <option value="Admin">Admin</option>
                                <option value="Analyst">Analyst</option>
                                <option value="Customer">Customer</option>
                                <option value="Patient">Patient</option>
                                <option value="Doctor">Doctor</option>
                                <option value="IT">IT</option>
                            </select>
                            <span asp-validation-for="Register.Role" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">Register</button>
                        </div>

                        <div class="text-center">
                            <a asp-page="/Account/Login" class="text-decoration-none">
                                Already have an account? Login here
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
