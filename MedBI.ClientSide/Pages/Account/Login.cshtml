@page
@model MedBI.ClientSide.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-4">Login</h2>

                    <form method="post" asp-page-handler="Login" novalidate>
                        <div class="mb-3">
                            <label asp-for="Login.Role" class="form-label">Role</label>
                            <select asp-for="Login.Role" class="form-select">
                                <option value="">Select Role</option>
                                <option value="Admin">Admin</option>
                                <option value="Analyst">Analyst</option>
                                <option value="Customer">Customer</option>
                                <option value="Patient">Patient</option>
                                <option value="Doctor">Doctor</option>
                                <option value="IT">IT</option>
                            </select>
                            <span asp-validation-for="Login.Role" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Login.Username" class="form-label">Username</label>
                            <input asp-for="Login.Username" class="form-control" placeholder="Enter your username" />
                            <span asp-validation-for="Login.Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Login.Email" class="form-label">Email</label>
                            <input asp-for="Login.Email" class="form-control" type="email" placeholder="you@example.com" />
                            <span asp-validation-for="Login.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Login.Password" class="form-label">Password</label>
                            <input asp-for="Login.Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Login.Password" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">Login</button>
                        </div>
                    </form>

                    <div class="text-center">
                        <a asp-page="/Account/Register" class="text-decoration-none">
                            Don’t have an account? Register here
                        </a>
                    </div>

                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
